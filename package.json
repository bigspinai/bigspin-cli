{
  "name": "@bigspinai/cli",
  "version": "0.1.1",
  "description": "Bigspin CLI - Command-line interface for the Bigspin API",
  "type": "module",
  "bin": {
    "bigspin": "bin/run.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --loader tsx bin/dev.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "oclif": {
    "bin": "bigspin",
    "dirname": "bigspin",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-version",
      "@oclif/plugin-not-found"
    ]
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "author": "Bigspin AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigspinai/bigspin-cli.git"
  },
  "homepage": "https://github.com/bigspinai/bigspin-cli#readme",
  "bugs": "https://github.com/bigspinai/bigspin-cli/issues",
  "keywords": ["bigspin", "cli", "api", "transcripts", "analytics", "ai", "evaluation"],
  "license": "MIT",
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-not-found": "^3",
    "@oclif/plugin-version": "^2",
    "@oclif/table": "^0.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.7",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@2": "^2.1.6",
      "brace-expansion@5": ">=5.0.12",
      "lodash": ">=4.18.0",
      "nanoid@3": "^3.3.18",
      "postcss": ">=8.5.18",
      "source-map-js": ">=1.2.2",
      "ws": ">=8.21.3"
    }
  }
}
